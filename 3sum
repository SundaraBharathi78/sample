#include <stdlib.h>

int cmp(const void* a, const void* b) { return *(int*)a - *(int*)b; }

int** threeSum(int* nums, int numsSize, int* rSize, int** rColSizes) {
    *rSize = 0;
    if (numsSize < 3) return NULL;
    qsort(nums, numsSize, sizeof(int), cmp);
    
    int cap = numsSize * 2, **res = malloc(cap * sizeof(int*));
    *rColSizes = malloc(cap * sizeof(int));

    for (int i = 0; i < numsSize - 2; i++) {
        if (i > 0 && nums[i] == nums[i - 1]) continue;
        int L = i + 1, R = numsSize - 1;
        while (L < R) {
            int sum = nums[i] + nums[L] + nums[R];
            if (sum == 0) {
                if (*rSize >= cap) {
                    cap *= 2;
                    res = realloc(res, cap * sizeof(int*));
                    *rColSizes = realloc(*rColSizes, cap * sizeof(int));
                }
                res[*rSize] = malloc(3 * sizeof(int));
                res[*rSize][0] = nums[i], res[*rSize][1] = nums[L], res[*rSize][2] = nums[R];
                (*rColSizes)[(*rSize)++] = 3;
                while (L < R && nums[L] == nums[L + 1]) L++;
                while (L < R && nums[R] == nums[R - 1]) R--;
                L++, R--;
            } else if (sum < 0) L++; else R--;
        }
    }
    return res;
}
