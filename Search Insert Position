int searchInsert(int* nums, int numsSize, int target) {
    int low = 0;
    int high = numsSize - 1;
    
    while (low <= high) {
        // Safe midpoint calculation to avoid integer overflow
        int mid = low + (high - low) / 2;
        
        if (nums[mid] == target) {
            return mid; 
        } else if (nums[mid] < target) {
            low = mid + 1; 
        } else {
            high = mid - 1; 
        }
    }
    
    // low marks the correct insertion index if target is missing
    return low; 
}
